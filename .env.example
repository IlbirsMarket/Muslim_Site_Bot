# ===== Образец файла .env =====
# Скопируйте этот файл в .env и впишите свои значения.
# Сам .env в git НЕ попадает — в нём секреты.

# Секретный ключ Django. Сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=впишите_сюда_свой_ключ

# С каких адресов можно обращаться к серверу (через запятую)
ALLOWED_HOSTS=127.0.0.1,localhost

# Адреса фронтенда, которым можно обращаться к API (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Адрес сайта для гостей — на него ведут QR-коды столов
SITE_URL=http://localhost:5173

# Секретный адрес Django-админки (на сервере обязателен: manage- и не меньше 12 случайных символов).
# Сгенерировать: python -c "import secrets; print('manage-' + secrets.token_urlsafe(12) + '/')"
DJANGO_ADMIN_URL=admin/

# ===== Telegram-бот (пусто — бот выключен, сайт работает как обычно) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Новые имена: бот сотрудников и бот гостей (два разных бота у @BotFather)
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_GUEST_BOT_TOKEN=
TELEGRAM_GUEST_BOT_USERNAME=
# Группа и темы ниже — только для первого запуска: потом ID меняются в админке, в карточке филиала
TELEGRAM_GROUP_ID=
TELEGRAM_TOPIC_ADMINS=
TELEGRAM_TOPIC_KITCHEN=
TELEGRAM_TOPIC_HALL=
TELEGRAM_TOPIC_DELIVERY=
TELEGRAM_TOPIC_REPORTS=

# Ночные копии базы в Telegram (группа «Архив»: только шеф и программист!)
TELEGRAM_ARCHIVE_CHAT_ID=
TELEGRAM_ARCHIVE_TOPIC_ID=
